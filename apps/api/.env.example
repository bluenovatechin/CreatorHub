# ---- Copy this file to .env and fill in the values. NEVER commit .env ----
NODE_ENV=development
PORT=4000

# MongoDB Atlas. Use a dedicated user with readWrite on this database only.
# Replace USER and PASSWORD (URL-encode special characters in the password) and keep the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@bluenovacreatorhub.g0tb9ev.mongodb.net/bluenova_dev?retryWrites=true&w=majority

# Exact browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5180,http://localhost:5181
COOKIE_SECURE=false
# In production: .bluenovatech.in
COOKIE_DOMAIN=

# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_long_random_value_at_least_64_characters_long_xxxxxxxx
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# One key is enough (DATA_ENCRYPTION_KEY). Use DATA_ENCRYPTION_KEYS={"v1":"...","v2":"..."} only when rotating keys.
DATA_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
DATA_ENCRYPTION_ACTIVE_VERSION=v1

# Website addresses used in email links
APP_BASE_URL=http://localhost:5180
ADMIN_BASE_URL=http://localhost:5181

# Emails
#   console = print links in this terminal (development only)
#   smtp    = send real emails through Gmail (or any SMTP server)
#   resend  = send through Resend (best for the live site, from your own domain)
#   brevo   = send through Brevo's web API (works on Render's free plan)
EMAIL_PROVIDER=console
# Gmail: SMTP_USER is the Gmail address that sends, SMTP_PASS is a 16-letter Google "App password" (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Brevo: works on hosts that block mail ports (e.g. Render free). EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=Bluenova Creator Hub <no-reply@bluenovatech.in>

# LOG_LEVEL=info   (uncomment to see detailed request logs)

# Proxies in front of the API: 1 locally / plain Render, 2 when the website reaches the API through Vercel
TRUST_PROXY_HOPS=1
# TESTING ONLY: run the live site without an email service (auto-verifies new accounts, shows a "test version" banner)
TEST_MODE=false

# "Continue with Google": OAuth 2.0 Client ID (Web application) from Google Cloud Console. Empty = button hidden.
GOOGLE_CLIENT_ID=

# Admin two-step login (authenticator code). Leave true. "false" = password alone opens the admin panel:
# ONLY for short testing; the admin panel shows a red warning bar while it is off.
ADMIN_TOTP_REQUIRED=true
# Most notification emails per 24 hours (Brevo free plan allows about 300/day).
EMAIL_DAILY_LIMIT=250
